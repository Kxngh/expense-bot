# --- Meta / WhatsApp Cloud API ---
# Permanent token from a System User (see README step 3)
WHATSAPP_TOKEN=
# "Phone number ID" from WhatsApp > API Setup (NOT the phone number itself)
PHONE_NUMBER_ID=
# Any string you make up; paste the same value in Meta's webhook settings
VERIFY_TOKEN=pick-a-long-random-string
# App settings > Basic > App secret. REQUIRED: unsigned webhooks are rejected, because
# without it anyone who finds your URL could pose as another user's number.
APP_SECRET=
# ALLOW_UNSIGNED_WEBHOOKS=on   # local testing only, never on a public server
GRAPH_VERSION=v26.0

# Your personal WhatsApp number with country code, no + (comma-separate for more)
ALLOWED_NUMBERS=91XXXXXXXXXX

# --- AI parsing: pick ONE provider ---
# gemini = free AI Studio key (text only by default) | claude = paid, reads photos | none = keyword parser
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Read photos of bills/UPI screenshots? Defaults: on for claude, off for gemini
# PARSE_IMAGES=off

# --- Automatic reports ---
WEEKLY_REPORT_DAY=6        # 0=Mon ... 6=Sun
WEEKLY_REPORT_HOUR=20      # 8 PM
MONTHLY_REPORT_HOUR=9      # 9 AM on the 1st
# Optional paid nudge when someone hasn't messaged in 24h (approved template name, no variables).
# Leave empty to hold the report and deliver it free with their next message.
REPORT_TEMPLATE=
REPORT_TEMPLATE_LANG=en
# Long random string. cron-job.org calls /tasks/reports?key=<this> at report time
# to wake a sleeping free-tier server (README: "Wake it up for reports").
CRON_SECRET=

# Your name, shown in the welcome message ("your expenses are stored on Krishna's server")
BOT_OWNER_NAME=

# --- App ---
DB_PATH=expenses.db
# Postgres (e.g. Neon's pooled connection string). When set, it's used instead of DB_PATH.
DATABASE_URL=
TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
